<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:cfg="using:Mesen.Config"
	xmlns:c="using:Mesen.Controls"
	xmlns:dc="using:Mesen.Debugger.Controls"
	mc:Ignorable="d"
  Design.Width="200"
  Design.Height="600"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	x:DataType="cfg:MdEventViewerConfig"
	x:Class="Mesen.Debugger.Views.MdEventViewerConfigView"
>
	<Design.DataContext>
		<cfg:MdEventViewerConfig />
	</Design.DataContext>

	<StackPanel>
		<Grid ColumnDefinitions="10, 1*, 10, 1*" RowDefinitions="Auto,Auto">
			<c:OptionSection Header="VDP writes" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0" />
			<c:OptionSection Header="VDP reads" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"  Margin="10 0 0 0" />
			<StackPanel Grid.Column="1" Grid.Row="1">
				<dc:EventViewerCategoryControl Text="Data" Config="{Binding VdpDataWrite}" />
				<dc:EventViewerCategoryControl Text="Control" Config="{Binding VdpControlWrite}" />
			</StackPanel>
			<StackPanel Grid.Column="3" Grid.Row="1">
				<dc:EventViewerCategoryControl Text="Data" Config="{Binding VdpDataRead}" />
				<dc:EventViewerCategoryControl Text="Status" Config="{Binding VdpControlRead}" />
				<dc:EventViewerCategoryControl Text="HV Counter" Config="{Binding VdpHvCounterRead}" />
			</StackPanel>
		</Grid>

		<Grid ColumnDefinitions="10, 1*, 10, 1*" RowDefinitions="Auto,Auto" Margin="0 15 0 0">
			<c:OptionSection Header="Audio" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0" />
			<c:OptionSection Header="Z80" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"  Margin="10 0 0 0" />
			<StackPanel Grid.Column="1" Grid.Row="1">
				<dc:EventViewerCategoryControl Text="PSG Write" Config="{Binding PsgWrite}" />
				<dc:EventViewerCategoryControl Text="FM Write" Config="{Binding FmWrite}" />
				<dc:EventViewerCategoryControl Text="FM Read" Config="{Binding FmRead}" />
			</StackPanel>
			<StackPanel Grid.Column="3" Grid.Row="1">
				<dc:EventViewerCategoryControl Text="RAM Write" Config="{Binding Z80RamWrite}" />
				<dc:EventViewerCategoryControl Text="RAM Read" Config="{Binding Z80RamRead}" />
				<dc:EventViewerCategoryControl Text="Bank Write" Config="{Binding Z80BankWrite}" />
				<dc:EventViewerCategoryControl Text="Bus Control" Config="{Binding Z80BusControl}" />
			</StackPanel>
		</Grid>

		<Grid ColumnDefinitions="10, 1*, 10, 1*" RowDefinitions="Auto,Auto" Margin="0 15 0 0">
			<c:OptionSection Header="Register writes" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0" />
			<c:OptionSection Header="Register reads" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"  Margin="10 0 0 0" />
			<StackPanel Grid.Column="1" Grid.Row="1">
				<dc:EventViewerCategoryControl Text="I/O" Config="{Binding IoWrite}" />
				<dc:EventViewerCategoryControl Text="Cart" Config="{Binding CartRegisterWrite}" />
			</StackPanel>
			<StackPanel Grid.Column="3" Grid.Row="1">
				<dc:EventViewerCategoryControl Text="I/O" Config="{Binding IoRead}" />
			</StackPanel>
		</Grid>

		<c:OptionSection Header="Other events" />
		<StackPanel>
			<dc:EventViewerCategoryControl Text="IRQ" Config="{Binding Irq}" />
			<dc:EventViewerCategoryControl Text="Marked Breakpoints" Config="{Binding MarkedBreakpoints}" />
		</StackPanel>

		<CheckBox Margin="0 10 0 0" IsChecked="{Binding ShowZ80Events}" Content="Show Z80 events" />
		<CheckBox Margin="0 2 0 0" IsChecked="{Binding ShowPreviousFrameEvents}" Content="Show previous frame events" />
	</StackPanel>
</UserControl>
